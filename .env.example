# Centralized PostgreSQL Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rentora
DATABASE_SYNC_URL=postgresql://postgres:postgres@localhost:5432/rentora

# API Keys & Secrets
JWT_SECRET_KEY=RENTORA_SUPER_SECRET_KEY

# Notifications & Third-Party
SENDGRID_API_KEY=SG.your_sendgrid_key
TWILIO_ACCOUNT_SID=ACyour_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Payments
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Onboarding & Documents
DOCUSIGN_INTEGRATION_KEY=your_docusign_key
DOCUSIGN_SECRET=your_docusign_secret

# Map Services
MAPTILER_KEY=VGr2EA4T8DcPNjZSXJos
MAPBOX_TOKEN=mock_token

# Object Storage Configuration
STORAGE_PROVIDER=local
R2_ACCESS_KEY=your_r2_key
R2_SECRET_KEY=your_r2_secret
R2_BUCKET=rentora-bucket
R2_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rentora-bucket

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ Configuration
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# KYC Configuration
KYC_ENCRYPTION_KEY=your_fernet_32_byte_base64_encryption_key
KYC_WEBHOOK_SECRET=your_kyc_webhook_hmac_secret_key

