# API Keys & Secrets
JWT_SECRET_KEY=your_super_secret_jwt_key
DATABASE_URL=sqlite:///./rentora_core.db

# Notifications
SENDGRID_API_KEY=your_sendgrid_key
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Payments
RAZORPAY_KEY_ID=your_razorpay_key
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Onboarding & Documents
DOCUSIGN_INTEGRATION_KEY=your_docusign_key
DOCUSIGN_SECRET=your_docusign_secret
WEASYPRINT_URL=optional_cloud_pdf_converter_if_needed

# Analytics
ANALYTICS_RETENTION_DAYS=365
REPORT_STORAGE_PATH=/tmp/rentora_reports
STORAGE_BUCKET_NAME=rentora-prod-reports
